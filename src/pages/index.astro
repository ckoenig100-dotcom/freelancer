---
import Layout from '../layouts/Layout.astro';
---

<Layout title="AngebotsPipeline">
  <main class="mx-auto flex max-w-2xl flex-col items-center px-6 py-24 text-center">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">AngebotsPipeline</h1>
    <p class="mt-4 text-lg text-slate-600">Automatische Angebotserstellung für Freelancer und Agenturen.</p>
    <a
      href={`${import.meta.env.BASE_URL}kontakt`}
      class="mt-8 inline-block rounded-lg bg-emerald-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-700"
    >
      Jetzt unverbindliches Angebot anfordern
    </a>
  </main>
</Layout>
