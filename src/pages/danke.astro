---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Danke für deine Anfrage | AngebotsPipeline">
  <main class="mx-auto flex max-w-2xl flex-col items-center px-6 py-24 text-center">
    <span class="mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100 text-3xl" aria-hidden="true">
      ✅
    </span>
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Danke!</h1>
    <p class="mt-4 text-lg text-slate-600">
      Du erhältst dein individuelles Angebot innerhalb von 24 Stunden per E-Mail.
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-lg bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800"
    >
      Zurück zur Startseite
    </a>
  </main>
</Layout>
