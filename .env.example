# URL des n8n-Webhooks, der die Kontaktformular-Daten entgegennimmt
# (Production-Webhook-URL aus dem n8n-Workflow, z.B. https://n8n.example.com/webhook/angebot)
PUBLIC_N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/kontaktformular

# Admin-Bereich (/admin) - Uebersicht aller versendeten Angebote
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
